{
  "name": "Impulsor Hub Cloud Workspace",
  "build": {
    "dockerfile": "../docker/Dockerfile.cloud-agent",
    "context": ".."
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Impulsor Hub",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "bash .devcontainer/start-hub.sh"
}
